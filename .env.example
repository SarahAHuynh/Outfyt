NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
OPENAI_API_KEY=
# Server-only model used for vision and styling. Keep your tested model/account access.
OPENAI_MODEL=gpt-5.4-mini
# Exact origin; use the assigned HTTPS website origin in Vercel Production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Reserved for future authorized integration; bookmarks do not need credentials.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Optional free reference-photo search. Account setup guide: docs/PHOTO_SETUP.md.
# Keep this server-side; do not prefix it with NEXT_PUBLIC_.
UNSPLASH_ACCESS_KEY=
